# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
PUBLIC_BASE_DOMAIN=localhost
FRONTEND_ORIGINS=http://localhost:3001
TRUST_PROXY=false

# PostgreSQL
DATABASE_URL="postgres://postgres:Lican%40136479Lican@painel.agentehap.com.br:5432/food-service?sslmode=disable"
DIRECT_URL=postgresql://saasfood:change-me@localhost:5432/saasfood?schema=public

# Authentication: replace with independently generated high-entropy secrets
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_REFRESH_TTL=30d
JWT_ISSUER=saasfood-api
JWT_AUDIENCE=saasfood-clients
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Data encryption: 32-byte key encoded as 64 hexadecimal characters
DATA_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters

# Email provider (credentials are configured when the provider is selected)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Asaas. Credentials are stored encrypted per restaurant, not in these global variables.
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_AUTH_TOKEN=
# Dedicated saasfood_webhook DB role; migration also requires a non-login
# saasfood_webhook_resolver role with BYPASSRLS to resolve payment references.
WEBHOOK_DATABASE_URL=

# Web Push VAPID keys
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# S3-compatible object storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
